{
  "manifest_version": 3,
  "name": "МойЩит — Защита и Привычки",
  "version": "1.0.0",
  "description": "Блокировка вредного контента и режима инкогнито, напоминания о здоровье, трекер привычек и накоплений",
  "permissions": [
    "storage",
    "alarms",
    "notifications",
    "declarativeNetRequest",
    "declarativeNetRequestWithHostAccess",
    "declarativeNetRequestFeedback",
    "tabs",
    "windows"
  ],
  "host_permissions": ["<all_urls>"],
  "incognito": "spanning",
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_start",
      "all_frames": false
    }
  ],
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "adult_block",
        "enabled": true,
        "path": "rules/adult.json"
      },
      {
        "id": "gambling_block",
        "enabled": true,
        "path": "rules/gambling.json"
      }
    ]
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "МойЩит",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_page": "options/options.html",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "web_accessible_resources": [
    {
      "resources": ["blocked.html"],
      "matches": ["<all_urls>"]
    }
  ]
}
